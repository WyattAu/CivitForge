# Generated by Cargo
debug
target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows debugging information
*.pdb

# Generated by cargo mutants (mutation testing data)
**/mutants.out*/

# Environment and secrets
.env
*.pem
*.key

# RustRover
# JetBrains specific template is maintained in a separate JetBrains.gitignore that can
# be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
# and can be added to the global gitignore or merged into this file.
#.idea/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store

# direnv
.direnv/

# Trunk/WASM build output (regenerated by `trunk build`)
crates/civit-ui/dist/
crates/civit-ui/.stage/

# Node (test harnesses manage their own node_modules)
node_modules/

# Tailwind compiled output (regenerated by trunk pre-build hook)
crates/civit-ui/assets/tailwind.css
