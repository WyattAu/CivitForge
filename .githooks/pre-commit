#!/bin/bash
# CivitForge pre-commit hook.
# Enforces: formatting, clippy (zero warnings), workspace tests, no emojis in
# committed source/documentation, Conventional Commit subject lines, no
# merge conflict markers, no large binary files, and no hardcoded secrets.
#
# Activation (run once per clone):
#   git config core.hooksPath .githooks
#
# Emergency bypass (use sparingly):
#   SKIP_PRE_COMMIT=1 git commit ...
#
# Fast path (skip slow test suite, keep fmt+clippy+lint):
#   SKIP_PRE_COMMIT_TESTS=1 git commit ...

set -euo pipefail

if [[ "${SKIP_PRE_COMMIT:-0}" == "1" ]]; then
    echo "==> [WARN] Skipping all pre-commit checks (SKIP_PRE_COMMIT=1)"
    exit 0
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()    { echo -e "${GREEN}==> [OK]${NC} $1"; }
fail()  { echo -e "${RED}==> [FAIL]${NC} $1"; }
info()  { echo -e "${YELLOW}==> [...]${NC} $1"; }

# Staged files (added/copied/modified/renamed), relative to repo root.
mapfile -t STAGED_FILES < <(git diff --cached --name-only --diff-filter=ACMR -- ':!Cargo.lock')

if [[ ${#STAGED_FILES[@]} -eq 0 ]]; then
    echo "==> No staged files; nothing to check."
    exit 0
fi

# ---------------------------------------------------------------------------
# 1. Emoji prohibition (enforces project "no emoji" documentation standard).
#    Rationale: CivitForge docs/code must remain emoji-free per style guide.
# ---------------------------------------------------------------------------
info "Scanning staged files for emoji..."
EMOJI_FOUND=0
# Unicode emoji property blocks (inclusive hex ranges). Catches pictographs,
# dingbats, symbols, and variation selectors without matching CJK used by i18n.
EMOJI_RANGE='[\x{1F000}-\x{1FAFF}\x{2600}-\x{27BF}\x{2190}-\x{21FF}\x{2B00}-\x{2BFF}\x{FE00}-\x{FE0F}\x{1F1E6}-\x{1F1FF}\x{2300}-\x{23FF}\x{2A00}-\x{2AFF}]'
# Rust/JS/Python escape sequences that produce emoji (e.g. \u{1F319}, \uD83C\uDF19).
EMOJI_ESCAPE='\\u\{?1[Ff][0-9A-Fa-f]{3}\}?|\\uD83[CDd][0-9A-Fa-f]{2}'
# Files that legitimately reference emoji code points for detection or documentation.
EMOJI_EXEMPT='(\.githooks/pre-commit|tests/gui/snapshot-traverse\.mjs|tests/gui/comprehensive-audit\.mjs|tests/gui/full-traverse\.mjs)'
for f in "${STAGED_FILES[@]}"; do
    [[ -f "$f" ]] || continue
    # Skip binary/asset files.
    case "$f" in
        *.png|*.jpg|*.jpeg|*.gif|*.ico|*.svg|*.woff|*.woff2|*.ttf|*.webp|*.icns) continue ;;
    esac
    # Skip files that reference emoji code points for detection (e.g. regex scanners).
    if [[ "$f" =~ $EMOJI_EXEMPT ]]; then
        continue
    fi
    if matches=$(LC_ALL=C grep -nP "$EMOJI_RANGE" "$f" 2>/dev/null); then
        echo -e "${RED}==> [FAIL]${NC} Emoji detected in $f:"
        echo "$matches" | head -5
        EMOJI_FOUND=1
    fi
    if matches=$(LC_ALL=C grep -nP "$EMOJI_ESCAPE" "$f" 2>/dev/null); then
        echo -e "${RED}==> [FAIL]${NC} Emoji escape sequence detected in $f:"
        echo "$matches" | head -5
        EMOJI_FOUND=1
    fi
done
if [[ $EMOJI_FOUND -ne 0 ]]; then
    fail "Remove all emoji from staged files (project standard: no emoji)."
    exit 1
fi
ok "No emoji in staged files."

# ---------------------------------------------------------------------------
# 2. Merge conflict marker detection
#    Prevents committing files with unresolved merge conflicts.
# ---------------------------------------------------------------------------
info "Checking for merge conflict markers..."
CONFLICT_FOUND=0
CONFLICT_PATTERN='^(<{7}|={7}|>{7}) '
for f in "${STAGED_FILES[@]}"; do
    [[ -f "$f" ]] || continue
    case "$f" in
        *.png|*.jpg|*.jpeg|*.gif|*.ico|*.svg|*.woff|*.woff2|*.ttf|*.webp|*.icns|*.bin|*.exe) continue ;;
    esac
    if matches=$(LC_ALL=C grep -nP "$CONFLICT_PATTERN" "$f" 2>/dev/null); then
        echo -e "${RED}==> [FAIL]${NC} Merge conflict markers in $f:"
        echo "$matches" | head -5
        CONFLICT_FOUND=1
    fi
done
if [[ $CONFLICT_FOUND -ne 0 ]]; then
    fail "Resolve all merge conflicts before committing."
    exit 1
fi
ok "No merge conflict markers."

# ---------------------------------------------------------------------------
# 3. Large file detection
#    Prevents accidentally committing large binaries or generated files.
# ---------------------------------------------------------------------------
info "Checking for large files (>1MB)..."
LARGE_FOUND=0
for f in "${STAGED_FILES[@]}"; do
    [[ -f "$f" ]] || continue
    SIZE=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [[ $SIZE -gt 1048576 ]]; then
        echo -e "${RED}==> [FAIL]${NC} Large file detected: $f ($(($SIZE / 1048576))MB)"
        LARGE_FOUND=1
    fi
done
if [[ $LARGE_FOUND -ne 0 ]]; then
    fail "Large files should be stored via Git LFS or excluded. Use SKIP_PRE_COMMIT=1 to bypass."
    exit 1
fi
ok "No large files in staged files."

# ---------------------------------------------------------------------------
# 4. Hardcoded secret detection
#    Scans for common secret patterns (API keys, passwords, tokens).
# ---------------------------------------------------------------------------
info "Scanning for hardcoded secrets..."
SECRET_FOUND=0
# Common secret patterns (case-insensitive)
SECRET_PATTERNS='(password|secret|api_key|apikey|api[-_]?secret|private_key|access_token|auth_token)\s*[:=]\s*["\x27][^\s"'\'']{8,}'
AWS_KEY='(AKIA[0-9A-Z]{16})'
JWT_PATTERN='eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]+'
for f in "${STAGED_FILES[@]}"; do
    [[ -f "$f" ]] || continue
    # Skip test files (they contain test secrets by design).
    case "$f" in
        *test*|*spec*|*.test.*|tests/*) continue ;;
    esac
    case "$f" in
        *.png|*.jpg|*.jpeg|*.gif|*.ico|*.svg|*.woff|*.woff2|*.ttf|*.webp|*.icns|*.lock) continue ;;
    esac
    if matches=$(LC_ALL=C grep -niP "$SECRET_PATTERNS" "$f" 2>/dev/null | grep -vi 'example\|placeholder\|change.me\|TODO\|FIXME\|dummy\|test\|mock\|fake'); then
        echo -e "${RED}==> [FAIL]${NC} Possible hardcoded secret in $f:"
        echo "$matches" | head -5
        SECRET_FOUND=1
    fi
    if matches=$(LC_ALL=C grep -nP "$AWS_KEY" "$f" 2>/dev/null); then
        echo -e "${RED}==> [FAIL]${NC} Possible AWS key in $f:"
        echo "$matches" | head -3
        SECRET_FOUND=1
    fi
    if matches=$(LC_ALL=C grep -nP "$JWT_PATTERN" "$f" 2>/dev/null | grep -v 'test\|mock\|example\|fixture'); then
        echo -e "${RED}==> [FAIL]${NC} Possible JWT token in $f:"
        echo "$matches" | head -3
        SECRET_FOUND=1
    fi
done
if [[ $SECRET_FOUND -ne 0 ]]; then
    fail "Remove hardcoded secrets. Use environment variables or a secrets manager."
    exit 1
fi
ok "No hardcoded secrets detected."

# ---------------------------------------------------------------------------
# 5. cargo fmt --check
# ---------------------------------------------------------------------------
info "Running cargo fmt --check --all"
if cargo fmt --check --all; then
    ok "Formatting check passed"
else
    fail "Formatting check failed -- run 'cargo fmt --all' then re-stage"
    exit 1
fi

# ---------------------------------------------------------------------------
# 6. cargo clippy (workspace, all targets, zero warnings)
# ---------------------------------------------------------------------------
info "Running cargo clippy --workspace --all-targets --locked -- -D warnings"
if cargo clippy --workspace --all-targets --locked -- -D warnings; then
    ok "Clippy lint passed (0 warnings)"
else
    fail "Clippy lint failed"
    exit 1
fi

# ---------------------------------------------------------------------------
# 7. cargo test --workspace (skip with SKIP_PRE_COMMIT_TESTS=1)
# ---------------------------------------------------------------------------
if [[ "${SKIP_PRE_COMMIT_TESTS:-0}" == "1" ]]; then
    echo -e "${YELLOW}==> [SKIP]${NC} Test suite skipped (SKIP_PRE_COMMIT_TESTS=1)"
else
    info "Running cargo test --workspace --locked"
    if cargo test --workspace --locked; then
        ok "All tests passed"
    else
        fail "Tests failed"
        exit 1
    fi
fi

# ---------------------------------------------------------------------------
# 8. Conventional Commit subject lint (informational; non-blocking)
# ---------------------------------------------------------------------------
COMMIT_MSG_FILE=$(git rev-parse --git-dir)/COMMIT_EDITMSG
if [[ -f "$COMMIT_MSG_FILE" ]]; then
    SUBJECT=$(head -1 "$COMMIT_MSG_FILE" | sed 's/[[:space:]]*$//')
    # Allow merge commits, revert commits, and fixup/autosquash.
    CONV_RE='^(fixup|squash|merge|revert|chore|docs|feat|fix|refactor|test|style|perf|build|ci|hotfix)(\([^)]+\))?!?: .+'
    if [[ ! "$SUBJECT" =~ $CONV_RE ]]; then
        echo -e "${YELLOW}==> [HINT]${NC} Subject not Conventional Commits compliant: '$SUBJECT'"
        echo -e "${YELLOW}         Expected: type(scope): description${NC}"
    fi
fi

echo -e "${GREEN}==> Pre-commit checks passed${NC}"
